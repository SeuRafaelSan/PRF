rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    // Strict user data isolation: authenticated users can only read/write their own subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Public resources collection (read-only for authenticated users or public as required)
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

