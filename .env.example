# Copie este arquivo para .env.local e preencha com SUAS chaves. Nunca coloque chaves reais aqui.

# OPENAI_API_KEY: opcional, reserva caso o Gemini falhe.
OPENAI_API_KEY=""

# GEMINI_API_KEY: provedor principal (questões, materiais, redação e imagens de mapa mental).
GEMINI_API_KEY=""

# YOUTUBE_API_KEY: busca de videoaulas.
YOUTUBE_API_KEY=""

# APP_URL: URL pública da plataforma depois de publicada (links e callbacks).
APP_URL=""

# AI_PROVIDER: provedor principal de IA, "gemini" (padrão) ou "openai".
# O outro é usado só como reserva; a OpenAI só entra se OPENAI_API_KEY estiver preenchida.
AI_PROVIDER="gemini"
